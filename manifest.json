{
  "manifest_version": 3,
  "name": "Amazon Listing Health Analyzer",
  "version": "1.0.0",
  "description": "Instantly analyze the health and quality of any Amazon listing globally based on 2024/2025 official seller compliance rules.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*.amazon.com/*",
    "https://*.amazon.com/*",
    "http://*.amazon.co.uk/*",
    "https://*.amazon.co.uk/*",
    "http://*.amazon.de/*",
    "https://*.amazon.de/*",
    "http://*.amazon.fr/*",
    "https://*.amazon.fr/*",
    "http://*.amazon.it/*",
    "https://*.amazon.it/*",
    "http://*.amazon.es/*",
    "https://*.amazon.es/*",
    "http://*.amazon.co.jp/*",
    "https://*.amazon.co.jp/*",
    "http://*.amazon.cn/*",
    "https://*.amazon.cn/*",
    "http://*.amazon.in/*",
    "https://*.amazon.in/*",
    "http://*.amazon.ca/*",
    "https://*.amazon.ca/*",
    "http://*.amazon.com.mx/*",
    "https://*.amazon.com.mx/*",
    "http://*.amazon.com.br/*",
    "https://*.amazon.com.br/*",
    "http://*.amazon.com.au/*",
    "https://*.amazon.com.au/*",
    "http://*.amazon.nl/*",
    "https://*.amazon.nl/*",
    "http://*.amazon.se/*",
    "https://*.amazon.se/*",
    "http://*.amazon.pl/*",
    "https://*.amazon.pl/*",
    "http://*.amazon.com.tr/*",
    "https://*.amazon.com.tr/*",
    "http://*.amazon.sg/*",
    "https://*.amazon.sg/*",
    "http://*.amazon.ae/*",
    "https://*.amazon.ae/*",
    "http://*.amazon.sa/*",
    "https://*.amazon.sa/*",
    "https://*.ssl-images-amazon.com/*",
    "https://*.media-amazon.com/*",
    "https://*.images-amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Listing Health"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.amazon.com/*",
        "https://*.amazon.com/*",
        "http://*.amazon.co.uk/*",
        "https://*.amazon.co.uk/*",
        "http://*.amazon.de/*",
        "https://*.amazon.de/*",
        "http://*.amazon.fr/*",
        "https://*.amazon.fr/*",
        "http://*.amazon.it/*",
        "https://*.amazon.it/*",
        "http://*.amazon.es/*",
        "https://*.amazon.es/*",
        "http://*.amazon.co.jp/*",
        "https://*.amazon.co.jp/*",
        "http://*.amazon.cn/*",
        "https://*.amazon.cn/*",
        "http://*.amazon.in/*",
        "https://*.amazon.in/*",
        "http://*.amazon.ca/*",
        "https://*.amazon.ca/*",
        "http://*.amazon.com.mx/*",
        "https://*.amazon.com.mx/*",
        "http://*.amazon.com.br/*",
        "https://*.amazon.com.br/*",
        "http://*.amazon.com.au/*",
        "https://*.amazon.com.au/*",
        "http://*.amazon.nl/*",
        "https://*.amazon.nl/*",
        "http://*.amazon.se/*",
        "https://*.amazon.se/*",
        "http://*.amazon.pl/*",
        "https://*.amazon.pl/*",
        "http://*.amazon.com.tr/*",
        "https://*.amazon.com.tr/*",
        "http://*.amazon.sg/*",
        "https://*.amazon.sg/*",
        "http://*.amazon.ae/*",
        "https://*.amazon.ae/*",
        "http://*.amazon.sa/*",
        "https://*.amazon.sa/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
